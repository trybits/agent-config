+        m = _MOCK_OPT_RE.match(line)
+        if m:
+            q.options[m.group(1)] = m.group(2).strip()
+            continue
+        m = _MOCK_ANS_RE.match(line)
+        if m:
+            q.answer = m.group(1)
+            continue
+        # 题干换行、粘进来的表格、别的东西 —— 与其悄悄吞掉，不如报出来
+        raise ParseError(f"Q{q.no} 里有无法识别的行：{line[:40]!r}")
+
+    q.note_raw = "\n".join(note).strip("\n")
